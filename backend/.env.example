# ===== 应用 =====
APP_SECRET_KEY=change-me-to-a-random-32-byte-hex
ENVIRONMENT=development
DEBUG=true

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000

# ===== 存储（默认 <仓库根>/data）=====
DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/musictag.db
# Docker 场景的默认曲库根目录
# MUSIC_ROOT=/music

# ===== CORS（逗号分隔）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 刮削 =====
MUSICBRAINZ_USER_AGENT=MusicTagLite/0.1.0 ( https://github.com/musictag-lite )
MUSICBRAINZ_RATE_LIMIT=1.0
# ACOUSTID_API_KEY=

# ===== 可选 AI 辅助文件名识别（默认关闭，仅手动触发，不会自动上传）=====
# 兼容 OpenAI 接口的服务均可：OpenAI / DeepSeek / 硅基流动 / LM Studio / Ollama
AI_ENABLED=false
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=

# ===== 鉴权（可选，默认关闭）=====
AUTH_ENABLED=false
